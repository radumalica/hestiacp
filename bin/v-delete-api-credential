#!/usr/local/hestia/php/bin/php
<?php
//# info: revoke an API v2 credential
//# options: CREDENTIAL_ID
//# labels: panel
//#
//# example: v-delete-api-credential 4f2b...c9 (the 40-character credential id)
//#
//# Deletes the credential record created by v-add-api-credential. This
//# is immediate and irreversible — the credential can no longer
//# authenticate via AccessKeyValidator once removed.
//#
//# This directory is writable only by root (see
//# CREDENTIAL_PROVISIONING_WIRING_DESIGN.md §2.1) — this command must be
//# run as root, exactly like v-delete-access-key.

require_once __DIR__ . "/../web/inc/auth/AccessKeyValidator.php";
require_once __DIR__ . "/../web/inc/auth/CredentialProvisioningException.php";
require_once __DIR__ . "/../web/inc/auth/CredentialCreationResult.php";
require_once __DIR__ . "/../web/inc/auth/AccessKeyProvisioner.php";
require_once __DIR__ . "/../web/inc/auth/CliOutcome.php";
require_once __DIR__ . "/../web/inc/auth/AccessKeyCli.php";

use Hestiacp\Auth\AccessKeyCli;
use Hestiacp\Auth\AccessKeyProvisioner;

$id = $argv[1] ?? "";

$cli = new AccessKeyCli(new AccessKeyProvisioner());
$outcome = $cli->revoke($id);

if ($outcome->stdout !== "") {
	fwrite(STDOUT, $outcome->stdout);
}
if ($outcome->stderr !== "") {
	fwrite(STDERR, $outcome->stderr);
}

exit($outcome->exitCode);
